<Window x:Class="RustMonitor.CombatLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RustMonitor.Controls" Title="Rust Monitor / コンバットログ" Width="1380" Height="760" MinWidth="1040" MinHeight="500" Background="#101820" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" Background="#101820">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="RefreshButton" Content="今すぐ更新" Click="Refresh_Click"/>
        <Button x:Name="PauseButton" Content="更新停止" Click="Pause_Click"/>
      </StackPanel>
      <StackPanel><TextBlock Text="COMBAT / LOG" FontSize="24" FontWeight="Bold"/><ui:SelectableText x:Name="PlayerHeading" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,3"/><ui:SelectableText x:Name="DestinationText" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <CheckBox x:Name="FollowLatest" Content="最新の記録へ自動スクロール" IsChecked="True" DockPanel.Dock="Right"/>
      <ui:SelectableText x:Name="CountText" Text="0 件 • 1分ごとに新しい記録を追記" Foreground="{StaticResource Muted}"/>
    </DockPanel>
    <Grid Grid.Row="2">
      <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" Background="#19232C" Foreground="#E7EEF3" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#344550" RowBackground="#19232C" AlternatingRowBackground="#1C2933" SelectionMode="Extended" MinRowHeight="54" ClipboardCopyMode="IncludeHeader">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293A47"/><Setter Property="Foreground" Value="#C9D8E2"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
          <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="日時（推定）" ClipboardContentBinding="{Binding TimeText}" Width="153"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding TimeText, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="種別" ClipboardContentBinding="{Binding Direction}" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Direction, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="攻撃側" ClipboardContentBinding="{Binding Attacker}" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Attacker, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="対象" ClipboardContentBinding="{Binding Target}" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Target, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="武器" ClipboardContentBinding="{Binding Weapon}" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Weapon, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="部位" ClipboardContentBinding="{Binding Area}" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Area, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="距離" ClipboardContentBinding="{Binding Distance}" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Distance, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="HP（前 → 後）" ClipboardContentBinding="{Binding Health}" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Health, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="情報" ClipboardContentBinding="{Binding Info}" Width="*" MinWidth="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:SelectableText Text="{Binding Info, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Text="コンバットログを取得しています…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <ui:SelectableText x:Name="StatusText" Text="取得待ち"/>
      <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Text="サーバーに残る直近の記録を1分ごとに取得します。取得の間に消えた記録は復元できません。&#x0a;日時は取得時刻と経過秒数からの推定です。IDはSteam IDではなくサーバー内のエンティティIDです。行にマウスを重ねると弾薬などの詳細を表示します。&#x0a;取得済みのログはサーバー・プレイヤー別にこのPCへ最大10,000件保存します。この窓を閉じると取得を停止します。"/>
    </StackPanel>
  </Grid>
</Window>
