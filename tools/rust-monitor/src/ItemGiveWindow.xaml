<Window x:Class="RustMonitor.ItemGiveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RustMonitor.Controls" Title="Rust Monitor / アイテムを付与" Width="1040" Height="700" MinWidth="1040" MinHeight="700" Background="#182129" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="CategoryTab" TargetType="ToggleButton">
      <Setter Property="Background" Value="#252D33"/><Setter Property="Foreground" Value="#D2D4CD"/><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="tab" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tab" Property="Background" Value="#657D3E"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ItemTile" TargetType="Button">
      <Setter Property="Background" Value="#222C35"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="Height" Value="168"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="#BAC997"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#697F40"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="FavoriteStar" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#AEB99F"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="20"/><Setter Property="Content" Value="☆"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="4,0"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="★"/><Setter Property="Foreground" Value="#DDECA4"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="22" Background="#182129">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <Button x:Name="ReloadButton" Content="一覧を更新" DockPanel.Dock="Right" VerticalAlignment="Top" Click="Reload_Click"/>
      <StackPanel><TextBlock Text="＋ アイテム" FontSize="25" FontWeight="Bold"/><ui:SelectableText x:Name="RecipientText" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2"/><ui:SelectableText x:Name="DestinationText" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" x:Name="SearchTools" Margin="0,0,0,10">
      <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="300" TextChanged="Search_Changed" ToolTip="アイテム名・日本語名（対応アイテム）・shortname・IDで検索"/>
      <TextBlock Text="名前で検索" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0"/>
      <ui:SelectableText x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </DockPanel>
    <WrapPanel Grid.Row="2" x:Name="CategoryTabs" Margin="0,0,0,7"/>
    <Grid Grid.Row="3">
      <ListBox x:Name="ItemRows" SizeChanged="ItemRows_SizeChanged" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid>
                <Button Style="{StaticResource ItemTile}" Click="Item_Click" ToolTip="{Binding Detail}">
                  <Grid IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Item.ShortName}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="8">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Image}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding Image}" Loaded="ItemImage_Loaded" DataContextChanged="ItemImage_DataContextChanged" Stretch="Uniform" Margin="8,6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="{Binding Item.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <ToggleButton Style="{StaticResource FavoriteStar}" IsChecked="{Binding Favorite, Mode=OneWay}" Click="Favorite_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,7,0,0" ToolTip="お気に入りに追加 / 解除"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Text="条件に合うアイテムがありません" Foreground="{StaticResource Muted}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="4" Background="#26343D" CornerRadius="5" Margin="0,12,0,0" Padding="14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="SelectedImage" Width="64" Height="64" Stretch="Uniform"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,14,0"><ui:SelectableText x:Name="SelectedName" Text="アイテムを選択してください" FontSize="18" FontWeight="SemiBold"/><ui:SelectableText x:Name="SelectedDetail" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" x:Name="QuantityTools" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="数量" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="QuantityBox" Text="1" Width="86" MaxLength="5" TextChanged="Quantity_Changed"/><Button x:Name="GiveButton" Content="付与する" Click="Give_Click" Background="#6A823F" Margin="10,0,0,0" MinWidth="108" IsEnabled="False"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><Button Content="1" Tag="1" Click="QuantityPreset_Click" Padding="10,3"/><Button Content="10" Tag="10" Click="QuantityPreset_Click" Padding="10,3"/><Button Content="100" Tag="100" Click="QuantityPreset_Click" Padding="10,3"/><Button Content="1000" Tag="1000" Click="QuantityPreset_Click" Padding="10,3"/><Button x:Name="StackButton" Content="スタック" Tag="stack" Click="QuantityPreset_Click" Padding="10,3" ToolTip="標準スタック数（1回の付与は最大10,000）"/></StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="5" Margin="0,12,0,0"><ui:SelectableText x:Name="StatusText" Text="一覧を取得しています…" TextWrapping="Wrap"/><TextBlock Text="画像を選び、数量を指定して「付与する」で実行 • 標準アイコン：Facepunch / Rust" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
  </Grid>
</Window>
