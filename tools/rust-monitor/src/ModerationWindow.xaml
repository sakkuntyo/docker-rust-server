<Window x:Class="RustMonitor.ModerationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RustMonitor.Controls"
        Title="Rust Monitor / 管理操作" Width="580" Height="530" MinWidth="520" MinHeight="490" Background="#10181F" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" Background="#10181F">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ui:SelectableText x:Name="TargetText" FontSize="14" Margin="0,0,0,14"/>
        <Border Background="#253340" Padding="14" CornerRadius="5"><ui:SelectableText x:Name="ActionText"/></Border>
        <StackPanel x:Name="ReasonPanel" Margin="0,18,0,0">
          <TextBlock Text="BAN理由" Margin="0,0,0,6"/>
          <TextBox x:Name="ReasonBox" MaxLength="200" Text="Banned by administrator"/>
        </StackPanel>
        <TextBlock Text="初回の実行時に、管理専用の補助プラグインをこのサーバーへSSHで配置します。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <ui:SelectableText x:Name="ResultText" Grid.Row="2" Margin="0,16,0,16" Text="対象を確認してから実行してください。"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Content="キャンセル" Click="Close_Click"/>
      <Button x:Name="ExecuteButton" Background="#A23E3E" Click="Execute_Click"/>
    </StackPanel>
  </Grid>
</Window>
