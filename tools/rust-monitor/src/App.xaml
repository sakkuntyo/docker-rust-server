<Application x:Class="RustMonitor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#19232C"/>
    <SolidColorBrush x:Key="Muted" Color="#9DADB9"/>
    <Style TargetType="ToolTip">
      <Style.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
      </Style.Resources>
      <Setter Property="Background" Value="#253340"/><Setter Property="Foreground" Value="#E7EEF3"/>
      <Setter Property="BorderBrush" Value="#7FA8C0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="MaxWidth" Value="460"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter RecognizesAccessKey="False"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HistoryMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="#19232C"/><Setter Property="Foreground" Value="#E7EEF3"/>
      <Setter Property="MinWidth" Value="360"/><Setter Property="MaxWidth" Value="460"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}" BorderBrush="#536675" BorderThickness="1" CornerRadius="7" Padding="5">
          <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HistoryItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="#344E60"/><Setter TargetName="row" Property="BorderBrush" Value="#7FA8C0"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#344E60"/><Setter TargetName="row" Property="BorderBrush" Value="#7FA8C0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="row" Property="Opacity" Value="0.6"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EEF3"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#293A47"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4,0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" x:Name="border"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#101A22"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3B4C59"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#101A22"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="BorderBrush" Value="#3B4C59"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CEDAE2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="bg" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="#344550"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#293A47"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
