<Application x:Class="RustMonitor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#19232C"/>
    <SolidColorBrush x:Key="Muted" Color="#9DADB9"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EEF3"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#293A47"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4,0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" x:Name="border"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#101A22"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3B4C59"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#101A22"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="BorderBrush" Value="#3B4C59"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CEDAE2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E7EEF3"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="bg" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="#344550"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#293A47"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
